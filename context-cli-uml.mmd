classDiagram
    direction LR

    class Main {
        +main(String[] args) void
    }

    namespace domain {
        class Conversation {
            -String id
            -String text
            -List~String~ participants
            +Conversation()
            +Conversation(String, String, List~String~)
            +getId() String
            +getText() String
            +getParticipants() List~String~
        }

        class Analysis {
            -double productivityScore
            -double sentimentScore
            -double resolutionScore
            -boolean complaint
            -boolean budget
            -boolean persona
            -boolean mixedSentiment
            -boolean confidence
            +isGood() boolean
        }

        class Analyzer {
            -String nlpVersion
            +analyze(Conversation) Analysis
        }

        class Insight {
            <<abstract>>
            +getMessage() String
        }

        class RiskInsight {
            +getMessage() String
        }

        class BusinessInsight {
            +getMessage() String
        }

        class InsightService {
            +verificarRiscoChurn(Analysis) boolean
            +verificarOportunidadeUpsell(Analysis) boolean
            +verificarReclamacao(Analysis) boolean
            +verificarBudget(Analysis) boolean
            +generate(Analysis) List~Insight~
        }
    }

    namespace dto {
        class Reuniao {
            -String idReuniao
            -String transcricao
            -String participantes
            -String origemEntrada
            -Timestamp dataAnalise
            -Integer predRisco
            -Integer predOportunidade
            -String sentimento
            -String produtosDetectados
            -String modeloAnalise
            -String classeModelo
            -BigDecimal probabilidadeModelo
            -String fonteDecisao
            +Reuniao()
            +gettersAndSetters()
        }
    }

    namespace dao {
        class ConnectionFactory {
            +abrirConexao() Connection
            +fecharConexao(Connection) void
        }

        class ReuniaoDAO {
            <<interface>>
            +inserir(Reuniao) String
            +listarTodos() List~Reuniao~
            +alterar(Reuniao) String
            +excluir(String) String
        }

        class ReuniaoDAOImpl {
            -Connection con
            +inserir(Reuniao) String
            +listarTodos() List~Reuniao~
            +alterar(Reuniao) String
            +excluir(String) String
        }
    }

    namespace repository {
        class JsonMeetingRepository {
            -Path jsonPath
            +buscarPorId(String) Optional~Conversation~
        }
    }

    namespace voice {
        class AudioRecorder {
            +gravar(Path) void
        }

        class SpeechToText {
            +transcrever(Path) String
        }

        class VoiceIdResolver {
            +resolverIdPorVoz() String
        }
    }

    namespace integration {
        class PythonModelClient {
            +predict(String) String
        }

        class PredicaoModelo {
            -String classe
            -boolean risco
            -double probabilidadeRisco
            +fromJson(String) PredicaoModelo
        }

        class HybridRiskService {
            +avaliar(Conversation, Analysis) DecisaoRisco
        }

        class DecisaoRisco {
            -boolean risco
            -double confianca
            -String fonte
            -String classeModelo
            -double probabilidadeModelo
        }
    }

    namespace service {
        class ReuniaoPersistenceService {
            +persistir(Conversation, Analysis, String) String
        }
    }

    namespace infrastructure {
        class ReportGenerator {
            +generateReport(Analysis, Conversation) void
        }
    }

    class PredictScript {
        <<Python script ai/predict.py>>
    }

    class TranscribeScript {
        <<Python script ai/transcribe_local.py>>
    }

    Insight <|-- RiskInsight
    Insight <|-- BusinessInsight
    ReuniaoDAO <|.. ReuniaoDAOImpl

    Main --> JsonMeetingRepository : busca por ID
    Main --> VoiceIdResolver : opcional
    Main --> Analyzer : analisa
    Main --> InsightService : gera insights
    Main --> ReuniaoPersistenceService : persiste
    Main --> ReportGenerator : relatorio

    Analyzer --> Conversation : recebe
    Analyzer ..> Analysis : produz
    InsightService --> Analysis : aplica regras
    InsightService ..> Insight : cria

    VoiceIdResolver --> AudioRecorder : grava WAV
    VoiceIdResolver --> SpeechToText : transcreve ID
    VoiceIdResolver --> JsonMeetingRepository : valida ID
    SpeechToText ..> TranscribeScript : ProcessBuilder

    HybridRiskService --> PythonModelClient : consulta
    HybridRiskService --> Analysis : fallback Java
    PythonModelClient ..> PredictScript : ProcessBuilder
    PythonModelClient ..> PredicaoModelo : interpreta JSON

    ReuniaoPersistenceService --> ReuniaoDAO : CRUD
    ReuniaoPersistenceService --> Reuniao : mapeia DTO
    ReuniaoPersistenceService --> HybridRiskService : decisão
    ReuniaoDAOImpl --> ConnectionFactory : conexão Oracle
    ReuniaoDAOImpl --> Reuniao : grava/lê
